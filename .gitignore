**/target/
**/*.rs.bk
**/Cargo.lock
!tools/rust/Cargo.lock

# Zig
**/.zig-cache/
**/zig-cache/
**/zig-out/

# D
.dub/
*.lst

# Go
**/vendor/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
.env/

# Nim
nimcache/
*.exe

# Node (if added later)
node_modules/

