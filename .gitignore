/build/
/out/
/dist/
/install/
cmake-build-*/
compile_commands.json

# Object / library artifacts anywhere
*.o
*.a
*.so
*.so.*
*.dylib
*.dll
*.lib
*.exe
*.out
*.app

# Meson / Ninja / CMake leftovers outside build/
